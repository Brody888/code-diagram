' ─────────────────────────────────────────────────────
' 通用语义宏 — 箭头 + 形状词汇
' 适用: 时序图 (sequence), 组件图 (component/architecture)
' 领域专用宏 (如嵌入式固件) 请见 examples/<domain>/
' ─────────────────────────────────────────────────────

' ═══════════════════════════════════════════
' Ⅰ. 通用语义箭头
' ═══════════════════════════════════════════

' ── RPC / 跨服务调用 ── 绿色虚线
!define ARROW_RPC -[#059669]-->

' ── HTTP / API 调用 ── 蓝色实线
!define ARROW_HTTP -[#2563eb]->

' ── 数据库查询 ── 青色虚线
!define ARROW_DB -[#0891b2]-->

' ── 消息队列 / 事件 ── 橙色实线
!define ARROW_EVENT -[#ea580c]->

' ── 中断 / 信号 ── 红色虚线
!define ARROW_SIGNAL -[#dc2626]-->

' ── 数据流 / 管道 ── 橙色实线
!define ARROW_DATA -[#ea580c]->

' ── 状态迁移 ── 灰色实线
!define ARROW_STATE -[#6b7280]->


' ═══════════════════════════════════════════
' Ⅱ. 通用形状词汇
' ═══════════════════════════════════════════

' ── 服务/后端节点 ──
!define SERVICE(id, label) rectangle "**SVC**\nlabel" as id

' ── 数据库/存储 ──
!define DATABASE(id, label) database "**DB**\nlabel" as id

' ── 消息队列 ──
!define QUEUE(id, label) node "**Queue**\nlabel" as id

' ── API 网关 ──
!define API_GW(id, label) hexagon "**API**\nlabel" as id

' ── 客户端/UI ──
!define CLIENT(id, label) rectangle "**Client**\nlabel" as id #LightBlue

' ── 外部服务 ──
!define EXTERNAL(id, label) rectangle "**Ext**\nlabel" as id #LightGray


' ═══════════════════════════════════════════
' Ⅲ. 图例模板
' ═══════════════════════════════════════════
' legend bottom right
'   <#059669>  |.. RPC / 跨服务 |
'   <#2563eb>  |= HTTP / API |
'   <#0891b2>  |.. Database |
'   <#ea580c>  |= Event / Queue |
'   <#dc2626>  |.. Signal / IRQ |
'   <#6b7280>  |= State |
' endlegend
