@startuml
!include /Users/hui/.claude/skills/code-diagram/styles/code-diagram-default.puml

title clci_config_t 实体关系\n(include/drivers/clci_common.h — 0x17c00, 256B + die[2]×256B)

' ═══════════════════════════════════════
' 核心实体
' ═══════════════════════════════════════

entity "clci_config_t" as cfg #LightBlue {
  * max_bits : uint8_t
  * min_bits : uint8_t
  * start_lane : uint8_t
  * end_lane : uint8_t
  --
  * die_id : uint8_t
  * loop_type : uint8_t
  * phy_mask : uint8_t
  * ref_clk : uint8_t
  --
  * pass_pat_num : uint32_t
  * clci_delay_ms : uint32_t
  * clci_base_addr : uint32_t
  --
  * sbd_soft_msg[4] : uint32_t
  * sys_exc_reg[4] : uint32_t
  --
  * commit_hash : uint32_t
  * fw_version : uint32_t
  * cmd_time : uint32_t
  * wdt_timeout_ms : uint32_t
  --
  * ucie_state_heart : uint32_t
  * ucie_state_info[4] : uint8_t
  --
  * rx_data_rterm[3] : uint32_t
  * tx_data_dcc[3] : uint32_t
  * rx_dcc[3] : uint32_t
  --
  * reserved_end[132] : uint8_t
}

' ═══════════════════════════════════════
' 嵌套 bitfield 配置
' ═══════════════════════════════════════

entity "clci_cfg2_t" as cfg2 #LightYellow {
  * div1 : 8
  * div2 : 8
  * diff_mode : 8
  * xlane : 4
  * xlane_clst : 4
}

entity "clci_cfg3_t" as cfg3 #LightYellow {
  * aphy_pll_mode : 1
  * postdiv : 2
  * exception_mode : 2
  * rx_lane_rev : 1
  * tracking_lane_back : 8
  --
  * reserved : 18
}

entity "clci_cfg5_t" as cfg5 #LightYellow {
  * tracking_lane : 8
  * tracking_mode : 4
  * tracking_enable : 1
  * tracking_lane_num : 2
  * loop_cnt : 16
}

' ═══════════════════════════════════════
' Die 实体 (含 lane 状态)
' ═══════════════════════════════════════

entity "clci_die_t" as die #LightGreen {
  * index : uint8_t
  * slave_addr : uint8_t
  * remap : uint8_t
  * addr_bitwidth : uint8_t
  --
  * pcs_start_lane : uint8_t
  * pcs_end_lane : uint8_t
  * tx_repair_lane : uint8_t
  * progress : uint8_t
  --
  * channel : uint32_t (bitmask)
  * channel1 : uint32_t (bitmask)
  * channel2 : uint32_t (bitmask)
  --
  * link_status[3] : uint32_t
  --
  * reserved_end[224] : uint8_t
}

' ═══════════════════════════════════════
' 外部引用
' ═══════════════════════════════════════

entity "clci_api_t" as api #FFE4E4 {
  * clci_link() : int32_t
  * clci_bitlock() : int32_t
  * clci_pcslock() : int32_t
  * clci_reset() : int32_t
  --
  * clci_aphy_init() : int32_t
  * clci_sphy_init() : int32_t
  * clci_aphy_pll_init() : int32_t
  * clci_mac_init() : int32_t
  * clci_modules_init() : int32_t
  --
  * clci_enter_l1() / _exit_l1()
  * clci_enter_l2() / _exit_l2()
  --
  * clci_async_link() : int32_t
  * clci_bist() : int32_t
  --
  * clci_delayline_tracking() : int32_t
  * clci_clk_counter() : int32_t
  * clci_iddq() : int32_t
}

' ═══════════════════════════════════════
' 关系
' ═══════════════════════════════════════

cfg ||--|| cfg2 : "嵌入 cfg2\n(0x08)"
cfg ||--|| cfg3 : "嵌入 cfg3\n(0x0c)"
cfg ||--|| cfg5 : "嵌入 cfg5\n(0x14)"
cfg ||--|{ die : "die[2]\ndie0 + die1\n(各 256B)"
cfg }o--|| api : "extern *\n(函数指针表)\nplatform_clci_api_init()"

note right of cfg
  **基址**: 0x17c00 (256B)
  **全局变量**: extern clci_config
  **初始化**: sep1_ram.c → sep1_cfg_default()
end note

note right of die
  **每 die 256B**
  die0: 0x17d00
  die1: 0x17e00
  channel bitmask: 16 lanes/ch
  link_status: bit-lock / pcs-lock
end note

note bottom of api
  **定义**: sep1_ram.c : platform_clci_api_init()
  **全部 20 个函数指针**
  由 product/<name>/ 实现赋值
end note

legend bottom right
  <#ADD8E6>  |= 核心配置 struct |
  <#FFFFE0>  |= bitfield 子配置 |
  <#90EE90>  |= Die 硬件映射 |
  <#FFE4E4>  |= 函数指针表 (外部) |
endlegend

@enduml
