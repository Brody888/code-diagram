' ─────────────────────────────────────────────────────
' CLCI 语义宏 — 硬件/固件专用箭头 + 形状词汇
' 加载: !include examples/clci/clci-semantic.puml
' ─────────────────────────────────────────────────────

' ══ Ⅰ. CLCI 语义箭头 (7 种) ══

!define ARROW_MMIO     -[#2563eb]->   ' 寄存器读写
!define ARROW_MBOX     -[#7c3aed]->   ' Mailbox 命令/响应
!define ARROW_SDB      -[#059669]-->  ' Sideband 跨 Die 消息
!define ARROW_MAINBAND -[#ea580c]->   ' Mainband 高速数据
!define ARROW_IRQ      -[#dc2626]-->  ' 中断 / Doorbell
!define ARROW_DMA      -[#0891b2]-->  ' DMA 传输
!define ARROW_STATE    -[#6b7280]->   ' 状态迁移

' ══ Ⅱ. CLCI 形状词汇 ══

!define REG(id, label, addr)        rectangle "**REG**\nlabel\naddr" as id
!define ISR_HANDLER(id, label)       hexagon "**ISR**\nlabel" as id
!define DMA_ENGINE(id, label)        folder "**DMA**\nlabel" as id
!define MAILBOX(id, label)           database "**Mailbox**\nlabel" as id
!define PHY_NODE(id, label)          node "**PHY**\nlabel" as id #LightCoral
!define CMD_ENTRY(id, label)         rectangle "**CMD**\nlabel" as id #LightBlue
!define DIE_NODE(id, label, color)   collections "**Die**\nlabel" as id

' ══ Ⅲ. 图例模板 ══
' legend bottom right
'   <#2563eb>  |= MMIO 寄存器读写 |
'   <#7c3aed>  |= Mailbox 命令响应 |
'   <#059669>  |.. Sideband 跨 Die 消息 |
'   <#ea580c>  |= Mainband 高速数据 |
'   <#dc2626>  |.. 中断 / Doorbell |
'   <#0891b2>  |.. DMA 传输 |
'   <#6b7280>  |= 状态迁移 |
' endlegend
