title cmd_clci_link() 流程\n(drivers/clci_command.c → product/sep1/src/sep1_ram.c → drivers/clci_link.c)

|#LightBlue| FW: clci_command.c |
start
:[[/api/source?file=drivers/clci_command.c&line=368 cmd_clci_link()]];
note right: [mailbox] CMD_CLCI_LINK (0x10)\n由 cmd_parser() 分发
:clci_api.clci_link();

|#LightGreen| Product: sep1_ram.c |
:[[/api/source?file=product/sep1/src/sep1_ram.c&line=548 sep1_link_with_int()]];
:[[/api/source?file=product/sep1/src/sep1_ram.c&line=524 sep1_link()]];

|#LightYellow| Bitlock: clci_link.c |
:[[/api/source?file=drivers/clci_link.c&line=503 clci_bitlock_en()]];
note right: [mmio] 对每个使能的 die\n遍历每条 lane 设置使能位

:[[/api/source?file=drivers/clci_link.c&line=505 clci_bitlock_state_check(0x1)]];
note right: [mmio] 轮询检查 bitlock\n状态位 == 0x1

if (state OK?) then (no)
  :return error;
  detach
else (yes)
endif

:[[/api/source?file=drivers/clci_link.c&line=509 clci_bitlock_state_trigger()]];
note right: [mmio] ×3 次触发\n推进 bitlock 状态机

:[[/api/source?file=drivers/clci_link.c&line=511 phase0_data_check()]];
note right: [mmio] Phase0 数据检查\nper die → per lane

if (phase0 data OK?) then (no)
  :return error;
  detach
else (yes)
endif

:[[/api/source?file=drivers/clci_link.c&line=517 phase0_clock_check()]];
note right: [mmio] Phase0 时钟检查\nclci_bitlock_state_phase0_clock_check_lane()

if (phase0 clock OK?) then (no)
  :return error;
  detach
else (yes)
endif

:[[/api/source?file=drivers/clci_link.c&line=521 delay_line_config()]];
note right: [mmio] 延迟线校准\nper die → per lane

:[[/api/source?file=drivers/clci_link.c&line=525 phase1_check()]];
note right: [mmio] Phase1 最终检查\n读 CLCI_CH_BIT_LOCK_CTRL1\n读 CLCI_CH_BIT_LOCK_CTRL2

if (phase1 OK?) then (no)
  :return error;
  detach
else (yes)
endif

|#FFE4E4| PCS Lock: clci_link.c |
:[[/api/source?file=drivers/clci_link.c&line=770 clci_pcslock()]];

:[[/api/source?file=drivers/clci_link.c&line=563 pcslock_trigger()]];
note right: [mmio] 触发 PCS lock\nper die → per lane\n(跳过 tracking lane)

:[[/api/source?file=drivers/clci_link.c&line=624 rx_fh_check()]];
note right: [mmio] 检查 RX Frame Header

if (RX FH OK?) then (no)
  :return error;
  detach
else (yes)
endif

:[[/api/source?file=drivers/clci_link.c&line=672 lane_sync_check()]];
note right: [mmio] Lane 同步检查

if (sync OK?) then (no)
  :return error;
  detach
else (yes)
endif

:[[/api/source?file=drivers/clci_link.c&line=720 lane_link_check()]];
note right: [mmio] Lane Link 状态检查

if (link OK?) then (no)
  :return error;
  detach
else (yes)
endif

:[[/api/source?file=drivers/clci_link.c&line=750 tx_en()]];
note right: [mmio] 使能 TX 输出

|#EDE9FE| MAC & Doorbell: sep1_ram.c |
:[[/api/source?file=product/sep1/src/sep1_ram.c&line=537 sep1_enable_mac_tx_ready()]];
note right: [mmio] 使能 MAC TX ready

:[[/api/source?file=product/sep1/src/sep1_ram.c&line=549 clci_read(die0, DOORBELL_TO_SOC)]];
note right: [mmio] 读 die0 doorbell 当前值

:[[/api/source?file=product/sep1/src/sep1_ram.c&line=550 clci_read(die1, DOORBELL_TO_SOC)]];
note right: [mmio] 读 die1 doorbell 当前值

if (sep1_link() == SUCCESS?) then (yes)
  :[[/api/source?file=product/sep1/src/sep1_ram.c&line=557 clci_write(die0, DOORBELL, LINK_OK_BIT)]];
  note right: [irq] die0 LINK_OK → SOC
  :clci_write(die1, DOORBELL, LINK_OK_BIT);
  note right: [irq] die1 LINK_OK → SOC
else (no)
  :[[/api/source?file=product/sep1/src/sep1_ram.c&line=553 clci_write(die0, DOORBELL, LINK_FAIL_BIT)]];
  note right: [irq] die0 LINK_FAIL → SOC
  :clci_write(die1, DOORBELL, LINK_FAIL_BIT);
  note right: [irq] die1 LINK_FAIL → SOC
  :return ret;
  detach
endif

|#LightBlue| FW: clci_command.c |
if (ret == 0?) then (yes)
  :CMD_RESP_SUCCESS;
else (no)
  :[[/api/source?file=drivers/clci_command.c&line=373 sys_error_save(SYS_ERROR_CLASS_LINK, ret)]];
  note right: 保存 link 错误码\n→ sys_error 模块
  :CMD_RESP_FAIL;
endif

stop

legend bottom right
  <#2563eb>  |= MMIO 寄存器 |
  <#dc2626>  |.. IRQ/Doorbell |
